# ART-PI source/API documentation; intentionally excludes vendored dependencies.
DOXYFILE_ENCODING       = UTF-8
PROJECT_NAME            = ART-PI
PROJECT_BRIEF           = STM32H750 firmware API and source reference
OUTPUT_DIRECTORY        = build/doxygen
OUTPUT_LANGUAGE         = English
ALLOW_UNICODE_NAMES     = YES

OPTIMIZE_OUTPUT_FOR_C   = YES
TYPEDEF_HIDES_STRUCT    = YES

INPUT                   = BSP/Board BSP/Drivers BSP/Storage UserSrc doxygen/mainpage.md
FILE_PATTERNS           = *.c *.h *.cpp *.hpp *.md
RECURSIVE               = YES
EXCLUDE                 = BSP/Board/CubeMX_Config
EXCLUDE_PATTERNS        = */CubeMX_Config/* */build/* */.git/*
EXCLUDE_SYMLINKS        = YES

MARKDOWN_SUPPORT        = YES
USE_MDFILE_AS_MAINPAGE  = doxygen/mainpage.md

EXTRACT_ALL             = YES
EXTRACT_STATIC          = YES
EXTRACT_PRIVATE         = NO

GENERATE_HTML           = YES
HTML_OUTPUT             = html
GENERATE_TREEVIEW       = YES
SEARCHENGINE            = YES
SOURCE_BROWSER          = YES
SHOW_INCLUDE_FILES      = YES

GENERATE_LATEX          = NO

HAVE_DOT                = YES
DOT_IMAGE_FORMAT        = svg
INCLUDE_GRAPH           = YES
INCLUDED_BY_GRAPH       = YES
DIRECTORY_GRAPH         = YES
CALL_GRAPH              = NO
CALLER_GRAPH            = NO

WARNINGS                = YES
WARN_IF_UNDOCUMENTED    = NO
WARN_IF_DOC_ERROR       = YES
WARN_AS_ERROR           = NO
WARN_LOGFILE            = build/doxygen/warnings.log
QUIET                   = YES
